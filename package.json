{
  "name": "dsh-persona-override",
  "version": "0.6.0",
  "description": "Replace the deployment persona from a named persona library, without declaring an agent preset.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nysparia/dsh-persona-override.git"
  },
  "homepage": "https://github.com/nysparia/dsh-persona-override#readme",
  "bugs": {
    "url": "https://github.com/nysparia/dsh-persona-override/issues"
  },
  "author": "nysparia",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "system-prompt"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.3.0-0",
    "react": "^18.2.0",
    "zod": ">=4.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node tests/host.mjs"
  }
}
